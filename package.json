{
  "name": "adyapan-hiring-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
